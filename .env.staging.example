# TAXIO V001 — staging env template (taxio-v001-staging)
# Copy to `.env.local` for local `npm run dev` on branch taxio-v001.
# For Vercel: set the SAME names on the STAGING project / Preview env only.
# NEVER paste these into the production taxio.be Vercel project.
# NEVER put production taxio.be Supabase keys here.
# Fill in values from: Supabase → taxio-v001-staging → Settings → API
# Do not commit real keys.

# ---------------------------------------------------------------------------
# Required: which Supabase project this build talks to
# ---------------------------------------------------------------------------
TAXIO_STAGING=true
VITE_TAXIO_STAGING=true

# Project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co

# anon / public (Settings → API → Project API keys → anon public)
VITE_SUPABASE_ANON_KEY=your-staging-anon-key

# service_role (Settings → API → Project API keys → service_role)
# Server-only. Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# ---------------------------------------------------------------------------
# Staging safety — do not send real customer mail
# TAXIO_STAGING=true already skips Resend in api/_utils.js.
# Leave RESEND_API_KEY unset. Do not copy the production Resend key.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# MAIL_FROM=
# MAIL_FROM_AUTOMATED=
# MAIL_FROM_ADMIN_COMM=
# MAIL_REPLY_TO=
# ADMIN_NOTIFY_EMAIL=

# ---------------------------------------------------------------------------
# Booking URLs — path-only on staging (/book/:slug)
# Do NOT set this to taxio.be (that is production).
# ---------------------------------------------------------------------------
# VITE_TAXIO_BOOKING_ROOT_DOMAIN=
# VITE_TAXIO_BOOKING_RESERVED_SUBDOMAINS=

# Optional API prefix (leave empty = same origin)
# VITE_API_BASE_URL=

# Local: Vite serves /api unless you point at `vercel dev`
# VITE_API_PROXY_TARGET=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional: Maps / Turnstile (use staging-restricted keys, or leave disabled)
# ---------------------------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
VITE_TURNSTILE_SITE_KEY=
VITE_TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false

# Staging-only admin fixture cleanup (never enable on production)
# TAXIO_DEV_CLEANUP_ENABLED=true
# VITE_ENABLE_DEV_CLEANUP=true
# TAXIO_DEV_CLEANUP_DELETE_AUTH=false
