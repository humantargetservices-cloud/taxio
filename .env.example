# Supabase (Settings → API in dashboard)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Maps JavaScript API + Places API (address autocomplete on booking page). Restrict key by HTTP referrer in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=
# Server-only Distance Matrix for /api/estimate-route (no HTTP referrer restriction). Falls back to VITE_GOOGLE_MAPS_API_KEY if unset.
GOOGLE_MAPS_SERVER_API_KEY=
VITE_TURNSTILE_SITE_KEY=
VITE_TURNSTILE_ENABLED=false

# Public booking on subdomains (production). Example: sabine.taxio.be loads the same booking UI as /book/sabine.
# Leave unset for localhost / previews — only path URLs like /book/:slug resolve a tenant.
# Deploy: wildcard DNS *.taxio.be → your host; add wildcard domain to the SPA project (e.g. Vercel Domains).
# VITE_TAXIO_BOOKING_ROOT_DOMAIN=taxio.be
# Optional comma-separated labels that must never be treated as company slugs (www is always reserved).
# VITE_TAXIO_BOOKING_RESERVED_SUBDOMAINS=app,staging

# Optional: prefix for API calls (default empty = same origin). Rarely needed.
# VITE_API_BASE_URL=

# Staging OneSignal Web Push (Custom Code). App ID from OneSignal → Settings → Keys & IDs.
# Do not put production App ID here. Set on Vercel staging env for staging.taxio.be builds.
# VITE_ONESIGNAL_APP_ID=
# Server-only REST API key for /api/company-push-dispatch → OneSignal Create Notification.
# Never expose to the browser / never prefix with VITE_.
# ONESIGNAL_REST_API_KEY=
# Optional absolute origin for OneSignal launch URL (defaults to https://staging.taxio.be).
# PUBLIC_APP_ORIGIN=https://staging.taxio.be

# Local dev: `npm run dev` runs /api/* via Vite middleware when this is unset.
# To use Vercel serverless locally instead, run `vercel dev` and point the Vite proxy at it:
# VITE_API_PROXY_TARGET=http://localhost:3000

# Server-only (Vercel project env vars — also used by local Vite /api middleware from .env)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_xxx
# Legacy fallback when purpose-specific vars below are unset.
MAIL_FROM=TAXIO <noreply@yourdomain.com>
# Optional overrides (otherwise automated uses MAIL_FROM, then TAXIO <noreply@taxio.be>)
# MAIL_FROM_AUTOMATED=TAXIO <noreply@taxio.be>
# Admin Communication tab only (otherwise MAIL_FROM, then TAXIO Team <info@taxio.be>)
# MAIL_FROM_ADMIN_COMM=TAXIO Team <info@taxio.be>
# Reply-To header on all outbound mail (defaults to humantargetservices@gmail.com if unset)
# MAIL_REPLY_TO=humantargetservices@gmail.com
ADMIN_NOTIFY_EMAIL=admin@yourdomain.com
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false

# Staging — Meta WhatsApp Cloud (TAXIO central number +32492702795)
# Inbound webhook /api/whatsapp-webhook accepts only this phone_number_id:
# WHATSAPP_PHONE_NUMBER_ID=1322109130989115
# WHATSAPP_VERIFY_TOKEN=long-random-string
# WHATSAPP_APP_SECRET=meta-app-secret
# Optional local/staging only (never production): allow POST without signature while wiring Meta
# WHATSAPP_WEBHOOK_ALLOW_UNSIGNED=true

# Staging Rescue — passenger WhatsApp Cloud API (TAXIO central number).
# ACTIVE templates (View Booking → /trip/:passenger_trip_token) — Meta IN REVIEW / approved:
#   taxio_rescue_offer_staging (en)
#     Body: {{1}}=original Company A, {{2}}=Rescue winner; confirm within 30 minutes.
#     Button: VIEW BOOKING → Dynamic URL https://staging.taxio.be/trip/ + {{1}}=passenger_trip_token
#   taxio_rescue_reminder_staging (en)
#     Body: {{1}}=Rescue winner; expires in 10 minutes.
#     Button: VIEW BOOKING → Dynamic URL https://staging.taxio.be/trip/ + {{1}}=passenger_trip_token
#   taxio_booking_confirmed_staging (en) — Company A accept
#     Body: {{1}}=company name, {{2}}=booking reference
#     Button: VIEW TRIP → Dynamic URL https://staging.taxio.be/trip/ + {{1}}=passenger_trip_token
#     CRITICAL: URL button type must be DYNAMIC. A static URL containing the characters "{{1}}"
#     produces /trip/%7B%7B1%7D%7D ("Link unavailable") because Meta never substitutes the token.
# Legacy (do not use for new sends): taxio_rescue_confirmation_staging (Confirm/Cancel QR)
# Production templates (EN/NL/FR): taxio_booking_confirmed, taxio_rescue_offer, taxio_rescue_reminder
# Language: booking_requests.passenger_locale → en | nl_BE | fr (staging *_staging names force en).
# WHATSAPP_BOOKING_CONFIRMED_TEMPLATE_NAME=taxio_booking_confirmed_staging
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=1476530895539889
# WHATSAPP_RESCUE_OFFER_TEMPLATE_NAME=taxio_rescue_offer_staging
# WHATSAPP_RESCUE_REMINDER_TEMPLATE_NAME=taxio_rescue_reminder_staging
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_APP_SECRET=meta-app-secret  # must match Meta app used for webhook HMAC
# WHATSAPP_BUSINESS_ACCOUNT_ID=        # optional — template status audit
# PUBLIC_APP_ORIGIN=https://staging.taxio.be
# Server tick for offer retries + 20m reminders (also accepts Vercel CRON_SECRET):
# RESCUE_WHATSAPP_TICK_SECRET=
# CRON_SECRET=

# Dev-only: allow platform_admin bulk delete of test fixtures (slug prefix "test" or companies.dev_fixture).
# Leave unset/false in production. Set VITE_ENABLE_DEV_CLEANUP=true to show the panel in the admin UI.
# TAXIO_DEV_CLEANUP_ENABLED=true
# VITE_ENABLE_DEV_CLEANUP=true
# Optional: delete orphan Auth users after removing their only test company (use with care).
# TAXIO_DEV_CLEANUP_DELETE_AUTH=true
