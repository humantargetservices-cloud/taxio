{
  "expo": {
    "name": "TAXIO Alert",
    "slug": "taxio-platform",
    "version": "0.2.1",
    "orientation": "portrait",
    "scheme": "taxiooperator",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "be.taxio.operator",
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_SPECIAL_USE",
        "WAKE_LOCK"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "be.taxio.operator",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true,
          "sounds": [
            "./assets/taxio_offer.wav"
          ]
        }
      ],
      "expo-secure-store",
      "./plugins/withTaxioForegroundService"
    ],
    "extra": {
      "taxioApiOrigin": "https://www.taxio.be",
      "eas": {
        "projectId": "bda84336-17c9-470c-831f-6680a2be36cf"
      }
    },
    "owner": "taxio-platform"
  }
}
