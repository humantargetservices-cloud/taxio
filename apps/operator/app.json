{
  "expo": {
    "name": "TAXIO Operator",
    "slug": "taxio-platform",
    "scheme": "taxiooperator",
    "version": "0.5.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "be.taxio.operator",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "be.taxio.operator"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/taxio_offer.wav"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bda84336-17c9-470c-831f-6680a2be36cf"
      }
    },
    "owner": "taxio-platform"
  }
}
